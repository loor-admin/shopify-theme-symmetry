{% liquid
  assign slot_key = side | append: '_slot'
  assign menu_key = side | append: '_menu'
  assign form_id = 'AnnouncementLocalization-' | append: section.id | append: '-' | append: side
%}
{% case section.settings[slot_key] %}
  {% when 'social' %}{% render 'social-icons', section: section %}
  {% when 'menu' %}
    <nav aria-label="{{ 'announcement.utility' | t }} ({{ side | escape }})"><ul class="ab__links">{% for link in section.settings[menu_key].links %}<li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>{% endfor %}</ul></nav>
  {% when 'localization' %}
    {% form 'localization', id: form_id, class: 'ab__localization' %}
      {% if section.settings.show_country and localization.available_countries.size > 1 %}
        <label class="ab__sr" for="{{ form_id }}-country">{{ 'announcement.country' | t }}</label>
        <select id="{{ form_id }}-country" name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>{% endfor %}</select>
      {% endif %}
      {% if section.settings.show_language and localization.available_languages.size > 1 %}
        <label class="ab__sr" for="{{ form_id }}-language">{{ 'announcement.language' | t }}</label>
        <select id="{{ form_id }}-language" name="language_code">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | escape }}</option>{% endfor %}</select>
      {% endif %}
      <button type="submit">{{ 'general.apply' | t }}</button>
    {% endform %}
{% endcase %}
