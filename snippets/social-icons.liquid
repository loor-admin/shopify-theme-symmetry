<ul class="ab__links ab__social" role="list">
  {% assign networks = 'instagram,facebook,youtube' | split: ',' %}
  {% for network in networks %}
    {% if section.settings[network] != blank %}
      <li><a href="{{ section.settings[network] }}" aria-label="{{ network | capitalize }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        {% case network %}
          {% when 'instagram' %}<rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
          {% when 'facebook' %}<path d="M14 22V13h3l.5-4H14V7c0-1 .5-2 2-2h2V1h-3c-4 0-5 3-5 6v2H7v4h3v9z" fill="currentColor"/>
          {% when 'youtube' %}<rect x="2" y="5" width="20" height="14" rx="4" stroke="currentColor" stroke-width="1.5"/><path d="m10 9 6 3-6 3z" fill="currentColor"/>
        {% endcase %}
      </svg></a></li>
    {% endif %}
  {% endfor %}
</ul>
