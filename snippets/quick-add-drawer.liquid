<quick-buy data-error="{{ 'general.load_error' | t | escape }}">
  <dialog class="drawer" aria-labelledby="QuickBuyHeading">
    <div class="drawer-heading"><h2 id="QuickBuyHeading">{{ 'products.choose_options' | t }}</h2><button type="button" data-close aria-label="{{ 'general.close' | t }}">×</button></div>
    <p data-quick-status role="status" aria-live="polite"></p>
    <div data-quick-content></div>
  </dialog>
</quick-buy>
