<div class="gallery section-space {% unless section.settings.full_bleed %}container{% endunless %} {% if section.settings.mobile_full_bleed %}mobile-bleed{% endif %}">
  {% for block in section.blocks %}
    {% liquid
      assign position = block.settings.image_position
      if section.settings.alternate
        assign remainder = forloop.index0 | modulo: 2
        if remainder == 1
          assign position = 'right'
        else
          assign position = 'left'
        endif
      endif
      assign button_align = 'flex-start'
      if block.settings.text_align == 'center'
        assign button_align = 'center'
      elsif block.settings.text_align == 'right'
        assign button_align = 'flex-end'
      endif
    %}
    <article class="split split--{{ position }} split--mobile-{{ section.settings.mobile_order }}" style="--text-align: {{ block.settings.text_align }}; --button-align: {{ button_align }}" {{ block.shopify_attributes }}>
      <div class="split-media">
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1800 | image_tag: widths: '360,540,750,1000,1400,1800', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy' }}
        {% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}
      </div>
      <div class="split-copy">
        {% if block.settings.badge != blank %}<span class="badge">{{ block.settings.badge | escape }}</span>{% endif %}
        <h2 class="heading-{{ block.settings.heading_size }}">{{ block.settings.heading | escape }}</h2>
        <div>{{ block.settings.text }}</div>
        {% if block.settings.subtext != blank %}<p>{{ block.settings.subtext | escape }}</p>{% endif %}
        <div class="split-buttons">
          {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
          {% if block.settings.secondary_label != blank and block.settings.secondary_link != blank %}<a class="button button--secondary" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label | escape }}</a>{% endif %}
        </div>
      </div>
    </article>
  {% endfor %}
</div>
{% schema %}
{
  "name":"Editorial split gallery","tag":"section","max_blocks":8,
  "disabled_on":{"groups":["header","footer"]},
  "settings":[
    {"type":"checkbox","id":"alternate","label":"Alternate image positions","default":true},
    {"type":"checkbox","id":"full_bleed","label":"Full width on desktop","default":false},
    {"type":"checkbox","id":"mobile_full_bleed","label":"Full width on mobile","default":true},
    {"type":"select","id":"mobile_order","label":"Mobile stack order","options":[{"value":"image","label":"Image first"},{"value":"text","label":"Text first"}],"default":"image"}
  ],
  "blocks":[{"type":"story","name":"Editorial story","settings":[
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"select","id":"image_position","label":"Image position (when alternating is off)","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"select","id":"text_align","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"text","id":"badge","label":"Badge","default":"The edit"},
    {"type":"text","id":"heading","label":"Heading","default":"A slower kind of statement"},
    {"type":"select","id":"heading_size","label":"Heading size","options":[{"value":"md","label":"Medium"},{"value":"lg","label":"Large"},{"value":"xl","label":"Extra large"}],"default":"lg"},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Considered design for the everyday.</p>"},
    {"type":"text","id":"subtext","label":"Secondary subtext"},
    {"type":"text","id":"button_label","label":"Primary button label","default":"Shop the edit"},
    {"type":"url","id":"button_link","label":"Primary link"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"Our story"},
    {"type":"url","id":"secondary_link","label":"Secondary link"}
  ]}],
  "presets":[
    {"name":"Editorial split banner","blocks":[{"type":"story"}]},
    {"name":"Alternating editorial gallery","blocks":[{"type":"story"},{"type":"story","settings":{"heading":"Objects with a point of view"}}]}
  ]
}
{% endschema %}
