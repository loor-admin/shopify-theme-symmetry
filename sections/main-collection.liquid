<section class="container section-space">
  <h1>{{ collection.title | escape }}</h1><div>{{ collection.description }}</div>
  <form method="get">
    <label for="SortBy">{{ 'products.sort' | t }}</label>
    {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
    <select id="SortBy" name="sort_by">{% for option in collection.sort_options %}<option value="{{ option.value | escape }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><button type="submit">{{ 'general.apply' | t }}</button>
  </form>
  {% paginate collection.products by 24 %}
    <div class="product-grid">{% for product in collection.products %}
      {% assign eager = false %}{% if forloop.index <= 4 %}{% assign eager = true %}{% endif %}
      {% render 'product-card', card_product: product, ratio: 'portrait', eager: eager, card_context: section.id %}
    {% else %}<p>{{ 'products.none' | t }}</p>{% endfor %}</div>
    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}
</section>
{% schema %}
{"name":"Main collection","settings":[]}
{% endschema %}
