<section class="container section-space">
  <h2>{{ section.settings.heading | escape }}</h2>
  <div class="product-grid">
    {% for product in section.settings.collection.products limit: section.settings.limit %}
      {% render 'product-card', card_product: product, ratio: section.settings.ratio, card_context: section.id %}
    {% else %}<p>{{ 'products.select_collection' | t }}</p>{% endfor %}
  </div>
</section>
{% schema %}
{"name":"Editorial product grid","settings":[{"type":"text","id":"heading","label":"Heading","default":"The considered collection"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":4,"max":16,"step":4,"default":8},{"type":"select","id":"ratio","label":"Image ratio","options":[{"value":"portrait","label":"Portrait 3:4"},{"value":"square","label":"Square 1:1"}],"default":"portrait"}],"presets":[{"name":"Editorial product grid"}]}
{% endschema %}
