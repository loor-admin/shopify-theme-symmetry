<section class="container section-space"><h1>{{ 'general.search' | t }}</h1>
  <predictive-search data-url="{{ routes.predictive_search_url }}" data-section="predictive-search" data-error="{{ 'general.load_error' | t | escape }}">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <label for="SearchInput">{{ 'general.search' | t }}</label>
      <input type="search" id="SearchInput" name="q" value="{{ search.terms | escape }}" autocomplete="off" aria-controls="PredictiveResults">
      <button type="submit" class="button">{{ 'general.search' | t }}</button>
    </form>
    <div id="PredictiveResults" data-results aria-live="polite"></div>
  </predictive-search>
  {% if search.performed %}{% paginate search.results by 24 %}
    <div class="product-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', card_product: result, card_context: section.id %}{% else %}<a href="{{ result.url }}">{{ result.title | escape }}</a>{% endif %}{% endfor %}</div>
    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}{% endif %}
</section>
{% schema %}
{"name":"Main search","settings":[]}
{% endschema %}
